# All secrets stay on the backend. Copy this file to .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_MB=50
MAX_AUDIO_SECONDS=600
MAX_CONCURRENT_INFERENCES=2
INFERENCE_QUEUE_TIMEOUT_SECONDS=10

# Six seconds of new audio plus six seconds of acoustic context.
REALTIME_WINDOW_SECONDS=6
# Short pause splitting can fragment telephone speech; disabled by default.
REALTIME_PAUSE_SPLIT=false
REALTIME_ANALYSIS_TIMEOUT_SECONDS=25
REALTIME_ANALYSIS_MIN_INTERVAL_SECONDS=10
# Legacy backlog threshold; the socket no longer closes after four pending windows.
REALTIME_QUEUE_WINDOWS=4
WS_IDLE_TIMEOUT_SECONDS=120

# Local STT. Realtime can use its own model or share the file model.
WHISPER_MODEL=small
WHISPER_REALTIME_MODEL=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=5
WHISPER_REALTIME_BEAM_SIZE=2
TORCH_CPU_THREADS=2

# Paths are relative to the backend root unless absolute. Blank disables KoELECTRA.
SYMPTOM_MODEL_PATH=
SYMPTOM_TOKENIZER_PATH=

# Wav2Vec2 weights and role names in checkpoint class order (0, 1).
SPEAKER_MODEL_PATH=
SPEAKER_CLASS_ROLES=["operator","caller"]

# Future Colab models: module:class (class(settings) -> provider).
# STT slot example: app.models.placeholders:SpeechModel
# CLASSIFIER_FACTORY takes precedence over SYMPTOM_MODEL_PATH.
# DIARIZER_FACTORY takes precedence over SPEAKER_MODEL_PATH.
TRANSCRIBER_FACTORY=
DIARIZER_FACTORY=
CLASSIFIER_FACTORY=

# Index the supplied PDFs with index_manuals.py before enabling the audio integration.
RAG_ENABLED=true
RAG_DATA_DIR=data/rag
RAG_EMBEDDING_MODEL=models/rag_embedding
RAG_SEARCH_TOP_K=20
RAG_ROUTE_MAX_DISTANCE=0.25
RAG_LLM_PROVIDER=gemini
# Blank model/key use GEMINI_MODEL and GEMINI_API_KEY with the Gemini provider.
RAG_LLM_MODEL=
RAG_LLM_API_KEY=
RAG_LLM_BASE_URL=http://localhost:11434/v1
RAG_LLM_TIMEOUT_SECONDS=20
RAG_LLM_ATTEMPT_TIMEOUT_SECONDS=10
RAG_LLM_MAX_RETRIES=1
RAG_LLM_FALLBACK_MODELS=["gemini-3.1-flash-lite"]

# All secrets stay on the backend. Copy this file to .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=45
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_MB=50
MAX_AUDIO_SECONDS=600
MAX_CONCURRENT_INFERENCES=2
INFERENCE_QUEUE_TIMEOUT_SECONDS=10

# Continuous PCM input is processed every 0.5~3 seconds (default 3).
REALTIME_WINDOW_SECONDS=3
REALTIME_ANALYSIS_TIMEOUT_SECONDS=3
REALTIME_QUEUE_WINDOWS=4
WS_IDLE_TIMEOUT_SECONDS=120

# Optional local STT baseline. First use may download weights.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LOCAL_FILES_ONLY=false

# Future Colab models: module:class (class(settings) -> provider).
# STT slot example: app.models.placeholders:SpeechModel
# Blank = optional Whisper baseline for STT, empty slots for the other models.
TRANSCRIBER_FACTORY=
DIARIZER_FACTORY=
AUDIO_ANALYZER_FACTORY=
CLASSIFIER_FACTORY=

# All secrets stay on the backend. Copy this file to .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_MB=50
MAX_AUDIO_SECONDS=600
MAX_CONCURRENT_INFERENCES=2
INFERENCE_QUEUE_TIMEOUT_SECONDS=10

# Maximum PCM window length (default 6 seconds). A speech pause can end it earlier.
REALTIME_WINDOW_SECONDS=6
REALTIME_ANALYSIS_TIMEOUT_SECONDS=15
REALTIME_ANALYSIS_MIN_INTERVAL_SECONDS=10
REALTIME_QUEUE_WINDOWS=4
WS_IDLE_TIMEOUT_SECONDS=120

# Local STT. Realtime can use its own model or share the file model.
WHISPER_MODEL=small
WHISPER_REALTIME_MODEL=
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LOCAL_FILES_ONLY=false
WHISPER_CPU_THREADS=4

# Paths are relative to the backend root unless absolute. Blank disables KoELECTRA.
SYMPTOM_MODEL_PATH=
SYMPTOM_TOKENIZER_PATH=

# Wav2Vec2 weights and role names in checkpoint class order (0, 1).
SPEAKER_MODEL_PATH=
SPEAKER_CLASS_ROLES=["operator","caller"]

# Future Colab models: module:class (class(settings) -> provider).
# STT slot example: app.models.placeholders:SpeechModel
# CLASSIFIER_FACTORY takes precedence over SYMPTOM_MODEL_PATH.
# DIARIZER_FACTORY takes precedence over SPEAKER_MODEL_PATH.
TRANSCRIBER_FACTORY=
DIARIZER_FACTORY=
AUDIO_ANALYZER_FACTORY=
CLASSIFIER_FACTORY=
